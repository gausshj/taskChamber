# Copy this file to .env only when overriding the Claude Code settings default.
# Without .env, the Claude adapter reads only provider routing fields from
# ~/.claude/settings.json. Never commit real values.
TASKCHAMBER_RUNTIME=claude
TASKCHAMBER_SANDBOX=auto
# Success-response text envelope: "full" (default) repeats the output in the
# legacy text block for clients without structuredContent support;
# "metadata_only" keeps only audit metadata in text and serves the generated
# body exclusively through structuredContent.output. See docs/MCP_CLIENT_SETUP.md.
# TASKCHAMBER_MCP_TEXT_MODE=full
# The pinned SDK-bundled CLI is used by default. Set an absolute path only for
# a reviewed, self-contained executable that works with PATH=/usr/bin:/bin and
# does not require adjacent files under a hidden home or /tmp directory.
# TASKCHAMBER_CLAUDE_CLI_PATH=/absolute/path/to/claude
TASKCHAMBER_DEFAULT_PROFILE=custom_provider
TASKCHAMBER_PROFILES=custom_provider
# Optional explicit non-secret project policy; otherwise taskchamber.toml is
# discovered in the server launch directory.
# TASKCHAMBER_CONFIG_FILE=/absolute/path/to/taskchamber.toml

# Each profile declares the agent runtime and wire protocol it actually supports.
# No protocol translation is performed by the MCP server.
TASKCHAMBER_PROFILE__CUSTOM_PROVIDER__RUNTIME=claude
TASKCHAMBER_PROFILE__CUSTOM_PROVIDER__API_FORMAT=anthropic
TASKCHAMBER_PROFILE__CUSTOM_PROVIDER__BASE_URL=https://example.invalid/api/anthropic
TASKCHAMBER_PROFILE__CUSTOM_PROVIDER__MODEL=replace-with-provider-model
TASKCHAMBER_PROFILE__CUSTOM_PROVIDER__API_KEY_FIELD=auth_token
TASKCHAMBER_PROFILE__CUSTOM_PROVIDER__API_KEY=

# Keep the readable workspace separate from this configuration when possible.
# TASKCHAMBER_WORKSPACE_ROOT=/absolute/path/to/a/safe/workspace

# Optional virtual document sources. MCP callers select these names; they never
# submit raw paths or commands. See docs/DOCUMENT_SOURCES.md for full examples.
TASKCHAMBER_DOCUMENT_SOURCES=
# TASKCHAMBER_DOCUMENT_SOURCE__DOCS__KIND=directory
# TASKCHAMBER_DOCUMENT_SOURCE__DOCS__ROOT=/absolute/path/to/docs
# TASKCHAMBER_DOCUMENT_SOURCE__DOCS__INCLUDE=**/*.md,**/*.txt
# TASKCHAMBER_DOCUMENT_SOURCE__CLI_DOCS__KIND=command
# TASKCHAMBER_DOCUMENT_SOURCE__CLI_DOCS__ARGV=["/absolute/path/to/doc-cli","fetch","--query","{query}"]
# TASKCHAMBER_DOCUMENT_SOURCE__CLI_DOCS__OUTPUT_FORMAT=json
# TASKCHAMBER_DOCUMENT_SOURCE__CLI_DOCS__ENV_ALLOW=DOC_API_TOKEN
# DOC_API_TOKEN=
